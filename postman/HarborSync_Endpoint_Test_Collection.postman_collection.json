{
  "info": {
    "name": "HarborSync - Endpoint Test Collection",
    "_postman_id": "6bf63ebd-676f-4a28-bf84-harborsync-endpoints",
    "description": "Covers HarborSync REST endpoints, gateway auth, positive paths, and representative error paths.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) { pm.environment.set('runId', Date.now().toString()); }",
          "if (!pm.environment.get('correlationId')) { pm.environment.set('correlationId', 'OP-PM-' + pm.environment.get('runId')); }",
          "const secret = pm.environment.get('jwtSecret') || 'harborsync-demo-jwt-secret';",
          "function b64urlWordArray(wordArray) { return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_'); }",
          "function b64urlJson(value) { return b64urlWordArray(CryptoJS.enc.Utf8.parse(JSON.stringify(value))); }",
          "const now = Math.floor(Date.now() / 1000);",
          "const header = b64urlJson({ alg: 'HS256', typ: 'JWT' });",
          "const payload = b64urlJson({ sub: 'postman-operator', scope: 'harborsync', iat: now, exp: now + 3600 });",
          "const signed = header + '.' + payload;",
          "const signature = b64urlWordArray(CryptoJS.HmacSHA256(signed, secret));",
          "pm.environment.set('jwtToken', signed + '.' + signature);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health Checks",
      "item": [
        {
          "name": "Gateway actuator health",
          "request": { "method": "GET", "url": "{{gatewayBaseUrl}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('gateway health is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Vessel actuator health",
          "request": { "method": "GET", "url": "{{vesselBaseUrl}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('vessel health is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Telemetry health",
          "request": { "method": "GET", "url": "{{telemetryBaseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('telemetry health is 200', () => pm.response.to.have.status(200));", "pm.test('runtime is go', () => pm.expect(pm.response.json().runtime).to.eql('go'));"] } }]
        },
        {
          "name": "Congestion actuator health",
          "request": { "method": "GET", "url": "{{congestionBaseUrl}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('congestion health is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Task actuator health",
          "request": { "method": "GET", "url": "{{taskBaseUrl}}/actuator/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('task health is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Notification health",
          "request": { "method": "GET", "url": "{{notificationBaseUrl}}/health" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('notification health is 200', () => pm.response.to.have.status(200));", "pm.test('rabbitmq connected flag exists', () => pm.expect(pm.response.json()).to.have.property('rabbitmqConnected'));"] } }]
        }
      ]
    },
    {
      "name": "Gateway Auth",
      "item": [
        {
          "name": "Reject gateway request without JWT",
          "request": { "method": "GET", "url": "{{gatewayBaseUrl}}/api/vessels" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('missing gateway JWT returns 401', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    },
    {
      "name": "Vessel API",
      "item": [
        {
          "name": "Create vessel - success",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"MV-Postman-{{runId}}\",\"imoNumber\":\"IMO{{runId}}\",\"berth\":\"B12\",\"eta\":\"2026-06-11T14:00:00\"}" },
            "url": "{{gatewayBaseUrl}}/api/vessels"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('create vessel returns 201', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.expect(body.status).to.eql('ARRIVING');", "pm.environment.set('vesselId', body.id);"] } }]
        },
        {
          "name": "Create vessel - duplicate IMO conflict",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"MV-Duplicate-{{runId}}\",\"imoNumber\":\"IMO{{runId}}\"}" },
            "url": "{{gatewayBaseUrl}}/api/vessels"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('duplicate vessel returns 409', () => pm.response.to.have.status(409));"] } }]
        },
        {
          "name": "Create vessel - validation error",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"name\":\"\",\"imoNumber\":\"\"}" },
            "url": "{{gatewayBaseUrl}}/api/vessels"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('validation returns 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json()).to.have.property('fields');"] } }]
        },
        {
          "name": "List vessels by ARRIVING",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/vessels?status=ARRIVING"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('list vessels returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json()).to.be.an('array');"] } }]
        },
        {
          "name": "Get vessel by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('get vessel returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().id).to.eql(pm.environment.get('vesselId'));"] } }]
        },
        {
          "name": "Get vessel - not found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/vessels/00000000-0000-0000-0000-000000000000"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('not found returns 404', () => pm.response.to.have.status(404));"] } }]
        },
        {
          "name": "Update vessel status to DOCKED",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"status\":\"DOCKED\",\"berth\":\"B12\"}" },
            "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}/status"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('status update returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('DOCKED');"] } }]
        },
        {
          "name": "Reserve berth",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"berth\":\"C3\"}" },
            "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}/berth/reserve"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('reserve berth returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('BERTHED');"] } }]
        },
        {
          "name": "Release berth",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}/berth/release"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('release berth returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('ARRIVING');"] } }]
        }
      ]
    },
    {
      "name": "Telemetry API",
      "item": [
        {
          "name": "Ingest telemetry - success",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"droneId\":\"HD-POSTMAN\",\"sector\":\"B-12\",\"containerCount\":94,\"capacity\":100,\"blockageDetected\":true,\"timestamp\":\"2026-06-11T14:28:00Z\",\"vesselEta\":\"14:30\"}" },
            "url": "{{telemetryBaseUrl}}/telemetry/ingest"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('telemetry accepted', () => pm.response.to.have.status(202));", "const body = pm.response.json();", "pm.expect(body.fillRate).to.eql(0.94);", "pm.expect(body.correlationId).to.eql(pm.environment.get('correlationId'));"] } }]
        },
        {
          "name": "Ingest telemetry - validation error",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"droneId\":\"\",\"sector\":\"\",\"containerCount\":5,\"capacity\":0,\"timestamp\":\"\"}" },
            "url": "{{telemetryBaseUrl}}/telemetry/ingest"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid telemetry returns 400', () => pm.response.to.have.status(400));", "pm.expect(pm.response.json()).to.have.property('error');"] } }]
        }
      ]
    },
    {
      "name": "Task API",
      "item": [
        {
          "name": "Wait for async task creation",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/tasks/pending"
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["const until = Date.now() + 8000;", "while (Date.now() < until) {}"] } },
            { "listen": "test", "script": { "exec": ["pm.test('pending tasks returns 200', () => pm.response.to.have.status(200));", "const tasks = pm.response.json();", "pm.expect(tasks).to.be.an('array');", "const task = tasks.find(t => t.correlationId === pm.environment.get('correlationId'));", "pm.expect(task, 'task created from telemetry correlationId').to.exist;", "pm.environment.set('taskId', task.id);"] } }
          ]
        },
        {
          "name": "Complete task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/tasks/{{taskId}}/complete"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('complete task returns 200', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('COMPLETED');"] } }]
        },
        {
          "name": "Complete task - invalid UUID",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{gatewayBaseUrl}}/api/tasks/not-a-uuid/complete"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid task UUID returns 400', () => pm.response.to.have.status(400));"] } }]
        }
      ]
    }
  ]
}
