{
  "info": {
    "name": "HarborSync - Simulation Collection",
    "_postman_id": "e6b5c16e-ef86-4b82-a7ff-harborsync-simulation",
    "description": "End-to-end port-operation scenario: vessel arrival, telemetry congestion, task creation, task completion, and vessel departure.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.environment.get('runId')) { pm.environment.set('runId', Date.now().toString()); }",
          "if (!pm.environment.get('correlationId')) { pm.environment.set('correlationId', 'OP-SIM-' + pm.environment.get('runId')); }",
          "const secret = pm.environment.get('jwtSecret') || 'harborsync-demo-jwt-secret';",
          "function b64urlWordArray(wordArray) { return CryptoJS.enc.Base64.stringify(wordArray).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_'); }",
          "function b64urlJson(value) { return b64urlWordArray(CryptoJS.enc.Utf8.parse(JSON.stringify(value))); }",
          "const now = Math.floor(Date.now() / 1000);",
          "const header = b64urlJson({ alg: 'HS256', typ: 'JWT' });",
          "const payload = b64urlJson({ sub: 'postman-operator', scope: 'harborsync', iat: now, exp: now + 3600 });",
          "const signed = header + '.' + payload;",
          "const signature = b64urlWordArray(CryptoJS.HmacSHA256(signed, secret));",
          "pm.environment.set('jwtToken', signed + '.' + signature);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Platform health snapshot",
      "request": { "method": "GET", "url": "{{gatewayBaseUrl}}/actuator/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('gateway is up', () => pm.response.to.have.status(200));"] } }]
    },
    {
      "name": "2. Vessel arrives at port approach",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
          { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"name\":\"MV-Simulation-{{runId}}\",\"imoNumber\":\"SIM{{runId}}\",\"berth\":\"B12\",\"eta\":\"2026-06-11T14:00:00\"}" },
        "url": "{{gatewayBaseUrl}}/api/vessels"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('vessel registered', () => pm.response.to.have.status(201));", "const vessel = pm.response.json();", "pm.expect(vessel.status).to.eql('ARRIVING');", "pm.environment.set('vesselId', vessel.id);"] } }]
    },
    {
      "name": "3. Drone reports increasing yard load",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"droneId\":\"HD-SIM-01\",\"sector\":\"B-12\",\"containerCount\":82,\"capacity\":100,\"blockageDetected\":false,\"timestamp\":\"2026-06-11T14:20:00Z\",\"vesselEta\":\"14:30\"}" },
        "url": "{{telemetryBaseUrl}}/telemetry/ingest"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('approach telemetry accepted', () => pm.response.to.have.status(202));", "pm.expect(pm.response.json().fillRate).to.eql(0.82);"] } }]
    },
    {
      "name": "4. Drone reports critical blockage",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"droneId\":\"HD-SIM-01\",\"sector\":\"B-12\",\"containerCount\":94,\"capacity\":100,\"blockageDetected\":true,\"timestamp\":\"2026-06-11T14:28:00Z\",\"vesselEta\":\"14:30\"}" },
        "url": "{{telemetryBaseUrl}}/telemetry/ingest"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('critical telemetry accepted', () => pm.response.to.have.status(202));", "pm.expect(pm.response.json().correlationId).to.eql(pm.environment.get('correlationId'));"] } }]
    },
    {
      "name": "5. Confirm operational task is created",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
        "url": "{{gatewayBaseUrl}}/api/tasks/pending"
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": ["const until = Date.now() + 8000;", "while (Date.now() < until) {}"] } },
        { "listen": "test", "script": { "exec": ["pm.test('pending task query succeeds', () => pm.response.to.have.status(200));", "const tasks = pm.response.json();", "const task = tasks.find(t => t.correlationId === pm.environment.get('correlationId'));", "pm.expect(task, 'simulation task').to.exist;", "pm.environment.set('taskId', task.id);"] } }
      ]
    },
    {
      "name": "6. Complete assigned field task",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
        "url": "{{gatewayBaseUrl}}/api/tasks/{{taskId}}/complete"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('task completed', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('COMPLETED');"] } }]
    },
    {
      "name": "7. Vessel docks after congestion response",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
          { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"DOCKED\",\"berth\":\"B12\"}" },
        "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}/status"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('vessel docked', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('DOCKED');"] } }]
    },
    {
      "name": "8. Vessel departs and final status is produced",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
          { "key": "X-Correlation-ID", "value": "{{correlationId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"status\":\"DEPARTED\"}" },
        "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}/status"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('vessel departed', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('DEPARTED');"] } }]
    },
    {
      "name": "9. Verify final vessel state",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
        "url": "{{gatewayBaseUrl}}/api/vessels/{{vesselId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('final vessel read succeeds', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().status).to.eql('DEPARTED');"] } }]
    },
    {
      "name": "10. Notification service remains healthy",
      "request": { "method": "GET", "url": "{{notificationBaseUrl}}/health" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('notification is healthy', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().rabbitmqConnected).to.eql(true);"] } }]
    }
  ]
}
